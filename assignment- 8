
#include <iostream>
using namespace std;

class Person
{
public:
    string name;
    int age;

    void getPerson()
    {
        cout << "Enter Name: ";
        cin >> name;
        cout << "Enter Age: ";
        cin >> age;
    }

    void displayPerson()
    {
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
    }
};

class Employee : public Person
{
public:
    int empID;

    void getEmployee()
    {
        cout << "Enter Employee ID: ";
        cin >> empID;
    }

    void displayEmployee()
    {
        cout << "Employee ID: " << empID << endl;
    }
};

class Manager : public Employee
{
public:
    string department;

    void getManager()
    {
        cout << "Enter Department: ";
        cin >> department;
    }

    void displayManager()
    {
        cout << "Department: " << department << endl;
    }
};

int main()
{
    Manager m;

    m.getPerson();
    m.getEmployee();
    m.getManager();

    cout << "\n--- Manager Details ---" << endl;

    m.displayPerson();
    m.displayEmployee();
    m.displayManager();

    return 0;
}
