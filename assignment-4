#include <iostream>
using namespace std;

class Book
{
public:
    string id, name, author;

    
    Book()
    {
        id = "11";
        name = "C++ course";
        author = " roshan k. ";
    }

    
    Book(string i, string n, string a)
    {
        id = i;
        name = n;
        author = a;
    }

    void display()
    {
        cout << "Book ID : " << id << endl;
        cout << "Book Name : " << name << endl;
        cout << "Author : " << author << endl;
        cout << "-------------------" << endl;
    }
};

int main()
{
    Book b1;
    Book b2("101", "rules of c++", " john R.");

    b1.display();
    b2.display();

    return 0;
}